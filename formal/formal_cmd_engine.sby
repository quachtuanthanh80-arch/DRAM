[options]
mode bmc
depth 20

[engines]
smtbmc z3

[script]
read -formal -sv ddr5_cmd_engine.sv
chparam -set BG_COUNT 2 ddr5_cmd_engine
chparam -set BANK_COUNT 2 ddr5_cmd_engine
chparam -set ROW_WIDTH 8 ddr5_cmd_engine
chparam -set COL_WIDTH 6 ddr5_cmd_engine
chparam -set ROWPRESS_THRESH_DEFAULT 10 ddr5_cmd_engine
prep -top ddr5_cmd_engine

[files]
/mnt/d/RAM/rtl/backend/ddr5_cmd_engine.sv
