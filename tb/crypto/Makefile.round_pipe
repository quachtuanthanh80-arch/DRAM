# Makefile for aes_round_pipe Cocotb verification
TOPLEVEL_LANG ?= verilog
SIM ?= verilator
WAVES ?= 0
SIM_BUILD ?= sim_build_round_pipe

ROOT_DIR ?= $(abspath $(CURDIR)/../..)

VERILOG_SOURCES ?= \
    $(ROOT_DIR)/rtl/crypto/aes_pkg.sv \
    $(ROOT_DIR)/rtl/crypto/aes_sbox.sv \
    $(ROOT_DIR)/rtl/crypto/aes_round_pipe.sv

TOPLEVEL ?= aes_round_pipe
MODULE ?= test_aes_round_pipe

EXTRA_ARGS += -Wno-DECLFILENAME -Wno-MULTITOP -Wno-UNUSEDSIGNAL -Wno-UNUSEDPARAM

COCOTB_SHARE_DIR ?= $(shell cocotb-config --makefiles 2>/dev/null || python3 -m cocotb_tools.config --makefiles 2>/dev/null || python -m cocotb_tools.config --makefiles 2>/dev/null)
include $(COCOTB_SHARE_DIR)/Makefile.sim
